# Dependencies
node_modules/

# Build output
dist/
/electron/release/

# Runtime data — databases, encrypted configs, sessions, IPC, env files, agent workspaces
# All personal data, auto-created at startup, must not be committed.
/data/
/logs/

# Legacy directories (migrated into data/ on first startup)
/store/
/groups/

# Backup archives from `make backup` — contain the session-secret key, the
# Claude provider encryption key and the full user SQLite database, i.e. the
# same secrets as /data/. Written to BACKUP_DIR (repo root by default).
miniclaw-backup-*.tar.gz

# Environment variables (may contain API keys and secrets)
.env
.env.*

# Secrets — catch-all for key/cert files that may appear anywhere
*.key
*.pem
*.keys.json

# Database files outside store/ (safety net)
*.db
*.db-wal
*.db-shm
*.sqlite

# npm lockfiles are build inputs and must be version-controlled for reproducible installs.
bun.lock
bun.lockb

# Build cache
.build-sentinel
*.tsbuildinfo
coverage/
playwright-report/
test-results/

# Local verification artifacts (not product/documentation assets)
/admin-mail-*.png
/inbox-after-readall.png

# Local tooling metadata
.claude/
.mcp.json
/.omc/
.trae/
.coco/
.agent/
.agents/
skills-lock.json
--connect
.playwright-mcp/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

/log/
nohup.out

# Pi runtime credentials — auth.json/models.json hold provider API keys
# (authPath = <agentDir>/auth.json; may be created outside data/ by host mode)
auth.json
models.json
.pi/

# IncidentAgent lab runtime artifacts
incident/logs/
incident/*-data/
# The independence audit writes its product next to the rounds directory it
# measured. When the table runs over the repository's own fixture rounds, that
# product lands inside the repository -- it is a generated artifact (it carries
# absolute paths of the measured environment), not source. The canonical
# product for the real rounds lives outside the repository, next to them.
incident/runs/independence-audit.json

# The diagnosis Agent's workspace used to live here (incident/workspace/) as
# its own git repository, so the agent could read the target service's history
# through that repo and never the lab's own history, which documents the
# injected faults. It moved OUT of the repository on 2026-11-04
# (see incident/L1-WORKSPACE-MOVE.md): the workspace now lives at
# /mnt/my-work/incident-lab/workspace, so that it is no longer adjacent to the
# answer key. The ignore rule is deliberately gone -- if a copy reappears at
# the old path, it must show up in `git status` as visible drift instead of
# being swallowed. Gate W (incident/runs/gate-w-workspace-isolation.mjs)
# fails if that path exists again.
