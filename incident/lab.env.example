# Baseline knobs for the incident lab. Copy to the path LAB_ENV points at
# (default: ~/.config/miniclaw-lab/lab.env) and edit there — the live copy
# deliberately lives outside the repository.
#
# Every compose call goes through incident/lab.sh, which passes --env-file.
# A bare `docker compose up` in this directory finds no .env and silently
# resets the knobs to the defaults in docker-compose.yml.
LOAD_PATHS=/api/orders/1,/api/orders/2,/api/orders/3,/api/orders/4,/api/orders/5
DOWNSTREAM_TIMEOUT_MS=2000
DB_POOL_SIZE=10
